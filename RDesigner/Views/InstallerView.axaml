<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Pyramid.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1130"
             d:DesignHeight="620"
             x:Class="Pyramid.Views.InstallerView"
             x:DataType="viewModels:InstallerViewModel">
    <Grid Margin="28">
        <Grid IsVisible="{Binding IsWelcomeVisible}"
              RowDefinitions="Auto,*,Auto">
            <StackPanel Spacing="10">
                <TextBlock Text="Pyramid"
                           FontSize="34"
                           FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource InstallerWelcomeText}"
                           FontSize="18"
                           Foreground="#424242" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Width="820"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto">
                <Button Command="{Binding OpenServerInstallCommand}"
                        MinHeight="128"
                        Margin="0 0 18 0"
                        Padding="20"
                        Background="#0B63CE"
                        Foreground="White"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource InstallerServerInstallTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource InstallerServerInstallDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Opacity="0.92" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        MinHeight="128"
                        Margin="18 0 0 0"
                        Padding="20"
                        Background="#0B63CE"
                        Foreground="White"
                        IsEnabled="False"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource InstallerClientInstallTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource InstallerClientInstallDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Opacity="0.92" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Width="390"
                        MinHeight="116"
                        Margin="0 34 0 0"
                        Padding="20"
                        Background="#0B63CE"
                        Foreground="White"
                        IsEnabled="False"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{DynamicResource InstallerAdvancedTitle}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{DynamicResource InstallerAdvancedDescription}"
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Opacity="0.92" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsLicenseVisible}"
              Width="880"
              HorizontalAlignment="Center"
              RowDefinitions="Auto,*,Auto,Auto">
            <TextBlock Text="{DynamicResource InstallerLicenseTitle}"
                       HorizontalAlignment="Center"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Margin="0 0 0 20" />

            <Border Grid.Row="1"
                    BorderBrush="#B8C5D6"
                    BorderThickness="1"
                    Background="#FAFAFA"
                    Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{DynamicResource InstallerLicenseText}"
                               TextWrapping="Wrap"
                               FontSize="14"
                               LineHeight="21"
                               Foreground="#303030" />
                </ScrollViewer>
            </Border>

            <CheckBox Grid.Row="2"
                      Content="{DynamicResource InstallerLicenseAcceptText}"
                      IsChecked="{Binding IsLicenseAccepted}"
                      Margin="0 18 0 18"
                      FontSize="15" />

            <Grid Grid.Row="3"
                  ColumnDefinitions="Auto,*,Auto">
                <Button Content="{DynamicResource InstallerBackButton}"
                        Command="{Binding BackToWelcomeCommand}"
                        MinWidth="110"
                        Height="38" />
                <Button Grid.Column="2"
                        Content="{DynamicResource InstallerNextButton}"
                        Command="{Binding ContinueToServerInstallCommand}"
                        MinWidth="110"
                        Height="38"
                        Background="#0B63CE"
                        Foreground="White" />
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsServerInstallVisible}"
              RowDefinitions="Auto,Auto,Auto,*">
            <Grid ColumnDefinitions="Auto,Auto,*">
                <Button Command="{Binding BackToLicenseCommand}"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Margin="0 1 12 0"
                        Background="Transparent"
                        BorderBrush="#B8C5D6"
                        Foreground="#0B63CE"
                        ToolTip.Tip="{DynamicResource InstallerBackButton}">
                    <TextBlock Text="←"
                               FontSize="22"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <TextBlock Grid.Column="1"
                           Text="{DynamicResource InstallerSubtitle}"
                           FontSize="28"
                           FontWeight="SemiBold" />
            </Grid>

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="0 18 0 8"
                  IsVisible="{Binding IsWindows}">
                <TextBlock Text="{DynamicResource InstallerInstallFolder}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBox Grid.Column="1"
                         Text="{Binding WindowsInstallDirectory}"
                         Watermark="{DynamicResource InstallerInstallFolderWatermark}"
                         Height="34"
                         Margin="12 0 0 0" />
                <Button Grid.Column="2"
                        Content="{DynamicResource InstallerBrowse}"
                        Command="{Binding BrowseInstallDirectoryCommand}"
                        MinWidth="96"
                        Height="34"
                        Margin="12 0 0 0" />
            </Grid>

            <TextBlock Grid.Row="1"
                       IsVisible="{Binding IsLinux}"
                       Text="{DynamicResource InstallerLinuxPostgresSystemInstallNote}"
                       Foreground="#555"
                       FontSize="14"
                       Margin="0 18 0 8"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,Auto,Auto,*"
                  Margin="0 8 0 18">
                <Button Content="{DynamicResource InstallerSilentInstall}"
                        Command="{Binding InstallArmCommand}"
                        MinWidth="170"
                        Height="40"
                        Background="#0B63CE"
                        Foreground="White" />
                <ProgressBar Grid.Column="1"
                             IsVisible="{Binding IsArmInstallProgressVisible}"
                             IsIndeterminate="True"
                             Width="38"
                             Height="8"
                             Margin="12 0 0 0"
                             VerticalAlignment="Center"
                             Foreground="#1FA34A"
                             Background="#D9F2E2" />
                <TextBlock Grid.Column="1"
                           IsVisible="{Binding IsArmInstallCompletedVisible}"
                           Text="✓"
                           Margin="12 0 0 0"
                           VerticalAlignment="Center"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#1FA34A" />
                <TextBlock Grid.Column="2"
                           IsVisible="{Binding IsArmInstallCancelledVisible}"
                           Text="{DynamicResource InstallerArmInstallCancelledShort}"
                           Margin="12 0 0 0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#C62828" />
                <TextBlock Grid.Column="2"
                           IsVisible="{Binding IsArmInstallSystemCancelledVisible}"
                           Text="{DynamicResource InstallerArmInstallSystemCancelledShort}"
                           Margin="12 0 0 0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="#C62828" />
            </Grid>

            <Border Grid.Row="3"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Background="#FAFAFA"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding LogText}"
                               FontFamily="Consolas"
                               FontSize="13"
                               TextWrapping="NoWrap">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource InstallerCopy}"
                                          Command="{Binding CopyLogCommand}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
