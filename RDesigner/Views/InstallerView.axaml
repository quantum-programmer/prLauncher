<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Pyramid.ViewModels"
             mc:Ignorable="d"
             d:DesignWidth="1130"
             d:DesignHeight="620"
             x:Class="Pyramid.Views.InstallerView"
             x:DataType="viewModels:InstallerViewModel">
    <Grid Margin="28">
        <Grid IsVisible="{Binding IsWelcomeVisible}"
              RowDefinitions="Auto,*,Auto">
            <StackPanel Spacing="10">
                <TextBlock Text="Pyramid"
                           FontSize="34"
                           FontWeight="SemiBold" />
                <TextBlock Text="Добро пожаловать в программу установки АРМ «Промприбор»"
                           FontSize="18"
                           Foreground="#424242" />
            </StackPanel>

            <Grid Grid.Row="1"
                  Width="820"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto">
                <Button Command="{Binding OpenServerInstallCommand}"
                        MinHeight="128"
                        Margin="0 0 18 0"
                        Padding="20"
                        Background="#0B63CE"
                        Foreground="White"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Установка АРМ Сервер"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Устанавливается клиентская и серверная часть ПО на одном компьютере. Работа с единой базой данных."
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Opacity="0.92" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        MinHeight="128"
                        Margin="18 0 0 0"
                        Padding="20"
                        Background="#0B63CE"
                        Foreground="White"
                        IsEnabled="False"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Установка АРМ Клиент"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Устанавливаются только клиентские компоненты. Пользователи работают с общей БД с нескольких рабочих мест."
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Opacity="0.92" />
                    </StackPanel>
                </Button>

                <Button Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Width="390"
                        MinHeight="116"
                        Margin="0 34 0 0"
                        Padding="20"
                        Background="#0B63CE"
                        Foreground="White"
                        IsEnabled="False"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Дополнительно"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Дополнительные сценарии установки и обслуживания будут доступны позже."
                                   TextWrapping="Wrap"
                                   FontSize="14"
                                   Opacity="0.92" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid IsVisible="{Binding IsServerInstallVisible}"
              RowDefinitions="Auto,Auto,Auto,*">
            <TextBlock Text="{DynamicResource InstallerSubtitle}"
                       FontSize="28"
                       FontWeight="SemiBold" />

            <Grid Grid.Row="1"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="0 18 0 8"
                  IsVisible="{Binding IsWindows}">
                <TextBlock Text="{DynamicResource InstallerInstallFolder}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold" />
                <TextBox Grid.Column="1"
                         Text="{Binding WindowsInstallDirectory}"
                         Watermark="{DynamicResource InstallerInstallFolderWatermark}"
                         Height="34"
                         Margin="12 0 0 0" />
                <Button Grid.Column="2"
                        Content="{DynamicResource InstallerBrowse}"
                        Command="{Binding BrowseInstallDirectoryCommand}"
                        MinWidth="96"
                        Height="34"
                        Margin="12 0 0 0" />
            </Grid>

            <TextBlock Grid.Row="1"
                       IsVisible="{Binding IsLinux}"
                       Text="PostgreSQL в Linux устанавливается системно из офлайн-пакетов. Папка установки PostgreSQL выбирается пакетным менеджером."
                       Foreground="#555"
                       FontSize="14"
                       Margin="0 18 0 8"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*"
                  Margin="0 8 0 18">
                <Button Content="{DynamicResource InstallerSilentInstall}"
                        Command="{Binding InstallArmCommand}"
                        MinWidth="170"
                        Height="40"
                        Background="#0B63CE"
                        Foreground="White" />
            </Grid>

            <Border Grid.Row="3"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    Background="#FAFAFA"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding LogText}"
                               FontFamily="Consolas"
                               FontSize="13"
                               TextWrapping="NoWrap">
                        <TextBlock.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{DynamicResource InstallerCopy}"
                                          Command="{Binding CopyLogCommand}" />
                            </ContextMenu>
                        </TextBlock.ContextMenu>
                    </TextBlock>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
